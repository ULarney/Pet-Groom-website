# Vercel: set all four in Project > Settings > Environment Variables.
# Local: copy to .env and fill in values; never commit .env.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY
# Local only; do not set VITE_API_BASE_URL on Vercel.
# VITE_API_BASE_URL=
PORT=5001
# Optional, run product seeding only when explicitly enabled.
SEED_PRODUCTS_ON_START=false
